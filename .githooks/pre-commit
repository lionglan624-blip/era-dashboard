#!/bin/bash
set -e
echo "=== Pre-commit CI (dashboard) ==="

# Lint check
echo "[1/3] ESLint + Prettier check..."
npx eslint backend/ frontend/src/ --quiet
npx prettier --check "backend/**/*.{js,cjs}" "frontend/src/**/*.{js,jsx,css}"

# Test
echo "[2/3] Running tests..."
npm run test

echo "[3/3] === CI PASSED ==="
